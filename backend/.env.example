# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sarvam AI API for Indic speech, TTS, translation (Hindi, Kannada)
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai

# OpenAI API Key (Whisper STT fallback)
OPENAI_API_KEY=

# Hugging Face Models
HF_TOKEN=
HF_INTENT_MODEL=facebook/bart-large-mnli
HF_NER_MODEL=dslim/bert-base-NER

# Vector Database: "pinecone" or "chromadb"
VECTOR_DB_TYPE=pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agri-assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=agri_knowledge_base

# Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# LLM Provider: "gemini", "groq", "openai", "mock"
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Live Data
DATA_GOV_IN_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
WEATHER_PROVIDER=open-meteo
SCHEME_CHECKER_MODE=rules

# Quality & DB
QUALITY_CONFIDENCE_THRESHOLD=0.70
DATABASE_URL=sqlite+aiosqlite:///./data/sessions.db
