# ==============================================================================
# AI-Driven Smart Farming Assistant - Free Tier Environment Configuration
# All external services run on 100% free tiers with NO credit card required.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & CORS Settings
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. LLM Providers (Free Tiers with Ordered Fallback: Gemini -> Groq -> Mock)
# ------------------------------------------------------------------------------
# Ordered provider chain tries Gemini first, falls back to Groq, then local mock.
LLM_PROVIDER=chain

# Google Gemini (Free tier via Google AI Studio - No credit card required)
# Get your free key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq (Free tier via Groq Console - No credit card required)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ------------------------------------------------------------------------------
# 3. Speech & Translation (Sarvam Indic Credits + Groq Whisper + Web Speech Fallback)
# ------------------------------------------------------------------------------
# Sarvam AI gives one-time trial credits upon signup at: https://dashboard.sarvam.ai/
# When credits expire or SARVAM_ENABLED=false, app automatically switches to Groq Whisper & browser TTS.
SARVAM_ENABLED=true
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai

# ------------------------------------------------------------------------------
# 4. Vector Store & Embeddings (Zero-cost Local Prebuilt Index, Fits 512 MB RAM)
# ------------------------------------------------------------------------------
# Default is 'local' (uses prebuilt JSON vector store with ONNX fastembed, 0 cloud cost)
VECTOR_DB_TYPE=local
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Optional cloud vector store (only if you have a free Pinecone index)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agri-assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Optional local ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=agri_knowledge_base

# ------------------------------------------------------------------------------
# 5. NLP & Classification Mode
# ------------------------------------------------------------------------------
# Keep false for 512MB RAM deployment (uses fast rule-classifier + free LLM fallback)
# Set true only on local machine with >4GB RAM to load local PyTorch HuggingFace models
ENABLE_HF_LOCAL=false
HF_TOKEN=
HF_INTENT_MODEL=facebook/bart-large-mnli
HF_NER_MODEL=dslim/bert-base-NER

# ------------------------------------------------------------------------------
# 6. Real-Time Data (Free Public APIs)
# ------------------------------------------------------------------------------
# Open-Meteo Weather (Free for non-commercial educational use, no key required)
WEATHER_PROVIDER=open-meteo

# data.gov.in AGMARKNET Mandi Prices
# Free registration at: https://data.gov.in/ (Sample mock used if empty)
DATA_GOV_IN_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Government Scheme Checker Mode ('rules' is local and 100% free)
SCHEME_CHECKER_MODE=rules

# ------------------------------------------------------------------------------
# 7. Quality Scoring & SQLite Persistence
# ------------------------------------------------------------------------------
QUALITY_CONFIDENCE_THRESHOLD=0.70
DATABASE_URL=sqlite+aiosqlite:///./data/sessions.db
