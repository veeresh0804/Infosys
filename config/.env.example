# ==============================================================================
# Smart Farming Assistant - Environment Configuration
# ==============================================================================

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Milestone 1: Speech, Translation & NLP
# ------------------------------------------------------------------------------
# Sarvam AI API for Indic speech-to-text, text-to-speech, and translation (Hindi, Kannada)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai

# OpenAI API Key (Whisper STT fallback when Sarvam doesn't cover language or errors)
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face Token (Optional, for HF Hub model downloads or HF Inference API)
HF_TOKEN=your_huggingface_token_here
HF_INTENT_MODEL=facebook/bart-large-mnli
HF_NER_MODEL=dslim/bert-base-NER

# ------------------------------------------------------------------------------
# Milestone 2: Knowledge Base, Vector DB & RAG Pipeline
# ------------------------------------------------------------------------------
# Vector Database Selection: "pinecone" (per user selection) or "chromadb"
VECTOR_DB_TYPE=pinecone

# Pinecone Settings (used when VECTOR_DB_TYPE=pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=agri-assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ChromaDB Settings (local fallback vector store)
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=agri_knowledge_base

# Embedding Model (384-dimensional local sentence-transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Large Language Model Provider for RAG Synthesis: "gemini" (Free tier), "groq", "openai", or "mock"
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# ------------------------------------------------------------------------------
# Milestone 2: Live Data API Integrations
# ------------------------------------------------------------------------------
# AGMARKNET / data.gov.in Mandi Prices API Key (if empty, clearly-labelled mock is used)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Weather Provider: "open-meteo" (free, no API key required) or "mock"
WEATHER_PROVIDER=open-meteo

# Government Scheme Eligibility Checker: "rules" (rule-based engine) or "mock"
SCHEME_CHECKER_MODE=rules

# ------------------------------------------------------------------------------
# Quality Scoring & Session State
# ------------------------------------------------------------------------------
# Confidence threshold below which answers are flagged for extension worker review
QUALITY_CONFIDENCE_THRESHOLD=0.70

# SQLite session database path
DATABASE_URL=sqlite+aiosqlite:///./data/sessions.db
